+            enabled: true,
+            available: true,
+            command: None,
+            resolved_command: None,
+            args: vec![],
+            env: vec![],
+            native_skills_dirs: None,
+            behavior_policy: BehaviorPolicy::default(),
+            yolo_id: Some(FULL_ACCESS_MODE.into()),
+            sort_order: 3130,
+            team_capable: false,
+            handshake: AgentHandshake::default(),
+        }
+    }
+
+    #[test]
+    fn full_access_writes_no_sandbox_and_never_approval() {
+        let values = config_values_for_mode(FULL_ACCESS_MODE);
+        assert_eq!(values.sandbox_mode, "danger-full-access");
+        assert_eq!(values.approval_policy, "never");
+    }
+
+    #[test]
+    fn non_full_access_restores_interactive_approval() {
+        let values = config_values_for_mode("auto");
+        assert_eq!(values.sandbox_mode, "workspace-write");
+        assert_eq!(values.approval_policy, "on-request");
+
+        let values = config_values_for_mode(READ_ONLY_MODE);
+        assert_eq!(values.sandbox_mode, "read-only");
+        assert_eq!(values.approval_policy, "on-request");
+    }
+
+    #[test]
+    fn auto_approval_only_applies_to_codex_full_access() {
+        assert!(codex_mode_uses_auto_approval(
+            &metadata(Some("codex")),
+            FULL_ACCESS_MODE
+        ));
+        assert!(codex_mode_uses_auto_approval(
+            &metadata(Some("codex")),
+            LEGACY_YOLO_NO_SANDBOX_MODE
+        ));
+        assert!(!codex_mode_uses_auto_approval(&metadata(Some("codex")), "auto"));
+        assert!(!codex_mode_uses_auto_approval(
+            &metadata(Some("claude")),
+            FULL_ACCESS_MODE
+        ));
+    }
+
+    #[test]
+    fn upsert_preserves_other_config_and_top_level_sections() {
+        let content = "# hi\nmodel = \"x\"\n[sandbox_workspace_write]\nnetwork_access = true\n";
+        let updated = upsert_root_string_key(
+            &upsert_root_string_key(content, "sandbox_mode", "danger-full-access"),
+            "approval_policy",
+            "never",
+        );
+
+        assert!(updated.contains("# hi\n"));
+        assert!(updated.contains("model = \"x\"\n"));
+        assert!(updated.contains("sandbox_mode = \"danger-full-access\"\n"));
+        assert!(updated.contains("approval_policy = \"never\"\n"));
+        assert!(updated.contains("[sandbox_workspace_write]\nnetwork_access = true\n"));
+        assert!(updated.find("approval_policy").unwrap() < updated.find("[sandbox_workspace_write]").unwrap());
+    }
+
+    #[test]
+    fn upsert_replaces_top_level_duplicates_without_touching_sections() {
+        let content = "sandbox_mode = \"workspace-write\"\nsandbox_mode = \"read-only\"\n[profile]\nsandbox_mode = \"read-only\"\n";
+        let updated = upsert_root_string_key(content, "sandbox_mode", "danger-full-access");
+
+        assert_eq!(updated.matches("sandbox_mode = \"danger-full-access\"").count(), 1);
+        assert!(updated.contains("[profile]\nsandbox_mode = \"read-only\"\n"));
+    }
+
+    #[test]
+    fn initial_mode_prefers_snapshot_then_build_config_then_codex_default() {
+        let meta = metadata(Some("codex"));
+        let mut config = AcpBuildExtra {
+            agent_id: None,
+            backend: Some("codex".into()),
+            cli_path: None,
+            agent_name: None,
+            custom_agent_id: None,
+            preset_context: None,
+            skills: vec![],
+            preset_assistant_id: None,
+            session_mode: Some("full-access".into()),
+            current_model_id: None,
+            cron_job_id: None,
+            team_mcp_stdio_config: None,
+            guide_mcp_config: None,
+            user_id: None,
+        };
+
+        assert_eq!(initial_codex_mode(&meta, &config, None), "full-access");
+
+        config.session_mode = None;
+        assert_eq!(initial_codex_mode(&meta, &config, None), "auto");
+    }
+}
