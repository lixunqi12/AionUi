+    /// Resolve all currently pending permissions with their first allow/proceed option.
+    pub fn auto_confirm_pending(&self, conversation_id: &str) -> Vec<String> {
+        if !self.auto_approve_all() {
+            return Vec::new();
+        }
+
+        let pending_items: Vec<(String, PendingPermission)> =
+            self.pending_permissions.lock().unwrap().drain().collect();
+        let mut confirmed_ids = Vec::with_capacity(pending_items.len());
+
+        for (call_id, pending) in pending_items {
