+fn auto_option_id_from_request(request: &agent_client_protocol::schema::RequestPermissionRequest) -> String {
+    let mut first = None;
+    let mut allow_candidate = None;
+
+    for option in &request.options {
+        let option_id = option.option_id.to_string();
+        first.get_or_insert_with(|| option_id.clone());
+
+        let haystack = format!("{} {} {:?}", option_id, option.name, option.kind).to_ascii_lowercase();
+        if haystack.contains("allow_always") || haystack.contains("always_allow") {
+            return option_id;
+        }
+        if allow_candidate.is_none() && (haystack.contains("allow") || haystack.contains("proceed")) {
+            allow_candidate = Some(option_id);
+        }
+    }
+
+    allow_candidate.or(first).unwrap_or_else(|| "allow_always".to_owned())
+}
+
+fn auto_option_id_from_confirmation(confirmation: &Confirmation) -> String {
+    let mut first = None;
+    let mut allow_candidate = None;
