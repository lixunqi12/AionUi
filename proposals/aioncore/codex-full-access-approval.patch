+        let Some(value) = confirmation_option_id(&option.value) else {
+            continue;
+        };
+        first.get_or_insert_with(|| value.clone());
+
+        let haystack = format!("{} {}", value, option.label).to_ascii_lowercase();
+        if haystack.contains("allow_always") || haystack.contains("always_allow") {
+            return value;
+        }
+        if allow_candidate.is_none() && (haystack.contains("allow") || haystack.contains("proceed")) {
+            allow_candidate = Some(value);
+        }
+    }
+
+    allow_candidate.or(first).unwrap_or_else(|| "allow_always".to_owned())
+}
+
+fn confirmation_option_id(value: &Value) -> Option<String> {
+    match value {
+        Value::String(v) => Some(v.clone()),
+        Value::Object(map) => map
+            .get("option_id")
+            .or_else(|| map.get("optionId"))
+            .or_else(|| map.get("value"))
+            .and_then(Value::as_str)
+            .map(ToOwned::to_owned),
+        _ => None,
+    }
+}
