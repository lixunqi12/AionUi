+use std::fs;
+use std::path::{Path, PathBuf};
+
+use aionui_api_types::{AcpBuildExtra, AgentMetadata};
+use aionui_common::AppError;
+
+use super::mode_normalize::normalize_requested_mode;
+use crate::shared_kernel::PersistedSessionState;
+
+const CODEX_BACKEND: &str = "codex";
+const FULL_ACCESS_MODE: &str = "full-access";
+const LEGACY_YOLO_MODE: &str = "yolo";
+const LEGACY_YOLO_NO_SANDBOX_MODE: &str = "yoloNoSandbox";
+const READ_ONLY_MODE: &str = "read-only";
+const CODEX_DEFAULT_MODE: &str = "default";
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+struct CodexConfigValues {
+    sandbox_mode: &'static str,
+    approval_policy: &'static str,
+}
+
+pub(crate) fn initial_codex_mode(
+    metadata: &AgentMetadata,
+    config: &AcpBuildExtra,
+    snapshot: Option<&PersistedSessionState>,
+) -> String {
+    snapshot
+        .and_then(|s| s.current_mode_id.as_ref())
+        .map(|m| normalize_requested_mode(metadata, m.as_str()))
+        .or_else(|| {
+            config
+                .session_mode
+                .as_deref()
+                .map(|m| normalize_requested_mode(metadata, m))
+        })
+        .filter(|mode| !mode.is_empty())
+        .unwrap_or_else(|| normalize_requested_mode(metadata, CODEX_DEFAULT_MODE))
+}
+
+pub(crate) fn codex_mode_uses_auto_approval(metadata: &AgentMetadata, mode: &str) -> bool {
+    is_codex_backend(metadata) && is_full_access_mode(mode)
+}
+
+pub(crate) fn sync_codex_config_for_mode(metadata: &AgentMetadata, mode: &str) -> Result<(), AppError> {
+    if !is_codex_backend(metadata) {
+        return Ok(());
+    }
+
+    let values = config_values_for_mode(mode);
+    let path = codex_config_path()?;
+    write_codex_config_at(&path, values)
+}
+
+fn is_codex_backend(metadata: &AgentMetadata) -> bool {
+    metadata.backend.as_deref() == Some(CODEX_BACKEND)
+}
+
+fn is_full_access_mode(mode: &str) -> bool {
+    matches!(
+        mode.trim(),
+        FULL_ACCESS_MODE | LEGACY_YOLO_MODE | LEGACY_YOLO_NO_SANDBOX_MODE
+    )
+}
+
+fn config_values_for_mode(mode: &str) -> CodexConfigValues {
+    if is_full_access_mode(mode) {
+        CodexConfigValues {
+            sandbox_mode: "danger-full-access",
+            approval_policy: "never",
+        }
+    } else if mode.trim() == READ_ONLY_MODE {
+        CodexConfigValues {
+            sandbox_mode: "read-only",
+            approval_policy: "on-request",
+        }
+    } else {
+        CodexConfigValues {
+            sandbox_mode: "workspace-write",
+            approval_policy: "on-request",
+        }
+    }
+}
+
+fn codex_config_path() -> Result<PathBuf, AppError> {
+    if let Ok(home) = std::env::var("CODEX_HOME")
+        && !home.trim().is_empty()
+    {
+        return Ok(PathBuf::from(home).join("config.toml"));
+    }
+
+    dirs::home_dir()
+        .map(|home| home.join(".codex").join("config.toml"))
+        .ok_or_else(|| AppError::Internal("Unable to resolve Codex config directory".into()))
+}
+
+fn write_codex_config_at(path: &Path, values: CodexConfigValues) -> Result<(), AppError> {
+    if let Some(parent) = path.parent() {
+        fs::create_dir_all(parent).map_err(|e| {
+            AppError::Internal(format!(
+                "Failed to create Codex config directory {}: {e}",
+                parent.display()
+            ))
+        })?;
+    }
+
+    let existing = match fs::read_to_string(path) {
+        Ok(content) => content,
+        Err(err) if err.kind() == std::io::ErrorKind::NotFound => String::new(),
+        Err(err) => {
+            return Err(AppError::Internal(format!(
+                "Failed to read Codex config {}: {err}",
+                path.display()
+            )));
+        }
+    };
+
+    let updated = upsert_root_string_key(
+        &upsert_root_string_key(&existing, "sandbox_mode", values.sandbox_mode),
+        "approval_policy",
+        values.approval_policy,
+    );
+
+    fs::write(path, updated)
+        .map_err(|e| AppError::Internal(format!("Failed to write Codex config {}: {e}", path.display())))
+}
+
+fn upsert_root_string_key(content: &str, key: &str, value: &str) -> String {
+    let newline = if content.contains("\r\n") { "\r\n" } else { "\n" };
+    let mut lines: Vec<String> = content.lines().map(ToOwned::to_owned).collect();
+
+    let section_index = lines
+        .iter()
+        .position(|line| line.trim_start().starts_with('['))
+        .unwrap_or(lines.len());
+
+    let replacement = |line: &str| {
+        let indent_len = line.len() - line.trim_start().len();
+        format!("{}{} = \"{}\"", &line[..indent_len], key, value)
+    };
+
+    let mut found = false;
+    let mut idx = 0;
+    while idx < section_index.min(lines.len()) {
+        if is_root_key_line(&lines[idx], key) {
+            if found {
+                lines.remove(idx);
+                continue;
+            }
+            lines[idx] = replacement(&lines[idx]);
+            found = true;
+        }
+        idx += 1;
+    }
+
+    if !found {
+        let insert_index = section_index.min(lines.len());
+        lines.insert(insert_index, format!("{key} = \"{value}\""));
+    }
+
+    let mut out = lines.join(newline);
+    out.push_str(newline);
+    out
+}
+
+fn is_root_key_line(line: &str, key: &str) -> bool {
+    let trimmed = line.trim_start();
+    if trimmed.starts_with('#') || !trimmed.starts_with(key) {
+        return false;
+    }
+
+    trimmed[key.len()..].trim_start().starts_with('=')
+}
