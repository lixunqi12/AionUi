+            let confirmation_id = pending.confirmation.id.clone();
+            if pending
+                .responder
+                .send(PermissionDecision::Selected { option_id })
+                .is_ok()
+            {
+                debug!(conversation_id = %conversation_id, call_id, "ACP permission auto-confirmed");
+                confirmed_ids.push(confirmation_id);
+            }
+        }
+
+        confirmed_ids
+    }
